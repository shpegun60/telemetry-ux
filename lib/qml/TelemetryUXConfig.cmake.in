# Relocatable optional Qt view exports. MIT.
@PACKAGE_INIT@
set(TelemetryUX_VERSION "@TELEMETRY_UX_VERSION@")
set_and_check(TelemetryUX_QML_IMPORT_PATH "@PACKAGE_TELEMETRY_UX_QML_INSTALL_DIR@")
if(NOT TelemetryUX_FIND_COMPONENTS)
    set(TelemetryUX_FIND_COMPONENTS configurator)
    set(TelemetryUX_FIND_REQUIRED_configurator TRUE)
endif()
foreach(_telemetry_ux_component IN LISTS TelemetryUX_FIND_COMPONENTS)
    set(TelemetryUX_${_telemetry_ux_component}_FOUND FALSE)
endforeach()
if(configurator IN_LIST TelemetryUX_FIND_COMPONENTS OR static_configurator IN_LIST TelemetryUX_FIND_COMPONENTS OR dynamic_configurator IN_LIST TelemetryUX_FIND_COMPONENTS OR qt_connection IN_LIST TelemetryUX_FIND_COMPONENTS)
    find_package(Qt6 6.4 QUIET COMPONENTS Core Qml Quick QuickControls2)
    if(Qt6_FOUND)
        set(TelemetryUX_configurator_FOUND TRUE)
        set(TelemetryUX_static_configurator_FOUND TRUE)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TelemetryUXTargets.cmake")
if((dynamic_configurator IN_LIST TelemetryUX_FIND_COMPONENTS OR qt_connection IN_LIST TelemetryUX_FIND_COMPONENTS) AND "@TELEMETRY_UX_BUILD_DYNAMIC_CONFIGURATOR@")
    find_package(Telemetry 0.1.0 EXACT QUIET CONFIG COMPONENTS workbench)
    if(Qt6_FOUND AND Telemetry_FOUND AND TARGET Telemetry::workbench)
        include("${CMAKE_CURRENT_LIST_DIR}/TelemetryUXDynamicTargets.cmake")
        set(TelemetryUX_dynamic_configurator_FOUND TRUE)
    endif()
endif()
if(qt_connection IN_LIST TelemetryUX_FIND_COMPONENTS AND "@TELEMETRY_UX_BUILD_QT_CONNECTION@")
    find_package(Telemetry 0.1.0 EXACT QUIET CONFIG COMPONENTS qt_connection)
    if(TelemetryUX_dynamic_configurator_FOUND AND Telemetry_FOUND AND TARGET Telemetry::qt_connection)
        include("${CMAKE_CURRENT_LIST_DIR}/TelemetryUXConnectionTargets.cmake")
        set(TelemetryUX_qt_connection_FOUND TRUE)
    endif()
endif()
check_required_components(TelemetryUX)
