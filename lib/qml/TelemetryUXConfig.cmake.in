# Relocatable optional Qt view exports. MIT.
@PACKAGE_INIT@
set(TelemetryUX_VERSION "@TELEMETRY_UX_VERSION@")
set_and_check(TelemetryUX_QML_IMPORT_PATH "@PACKAGE_TELEMETRY_UX_QML_INSTALL_DIR@")
if(NOT TelemetryUX_FIND_COMPONENTS)
    set(TelemetryUX_FIND_COMPONENTS configurator)
    set(TelemetryUX_FIND_REQUIRED_configurator TRUE)
endif()
foreach(_telemetry_ux_component IN LISTS TelemetryUX_FIND_COMPONENTS)
    set(TelemetryUX_${_telemetry_ux_component}_FOUND FALSE)
endforeach()
if(configurator IN_LIST TelemetryUX_FIND_COMPONENTS)
    find_package(Qt6 6.4 QUIET COMPONENTS Core Qml Quick QuickControls2)
    if(Qt6_FOUND)
        set(TelemetryUX_configurator_FOUND TRUE)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TelemetryUXTargets.cmake")
check_required_components(TelemetryUX)
